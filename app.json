{
  "expo": {
    "name": "Bespoke Measure",
    "slug": "bespoke-measure",
    "scheme": "bespokemeasure",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to capture reference photos for photo-assisted measurement estimation."
      }
    },
    "android": {
      "package": "com.bespokemeasure.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to capture reference photos for measurement estimation."
        }
      ],
      "expo-status-bar"
    ]
  }
}
